{
  "name": "@inventory-v2/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Inventory v2 API — NestJS + Prisma 7",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,prisma}/**/*.ts\" --max-warnings 0",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:remap-maintenance-links": "tsx prisma/remap-child-maintenance-links.ts",
    "db:studio": "prisma studio",
    "test:unit": "node --import tsx --test src/common/utils/org-hierarchy-validation.util.spec.ts src/common/utils/resolve-effective-warehouse.util.spec.ts src/common/utils/collect-open-org-subtree.util.spec.ts src/common/utils/document-number.util.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.24",
    "@nestjs/websockets": "^11.1.24",
    "@prisma/adapter-mariadb": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "docxtemplater": "^3.68.7",
    "dotenv": "^16.6.1",
    "mariadb": "^3.4.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pizzip": "^3.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.19.17",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^7.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
