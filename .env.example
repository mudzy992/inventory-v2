# --- App ---
APP_NAME=inventory-v2
APP_DISPLAY_NAME=Evidens
APP_SUBTITLE=Evidencija i zaduženje opreme
APP_URL=https://evidens.ba101.top
# Produkcija (Coolify, backend na svojoj subdomeni api.evidens.ba101.top): PRAZAN.
# Lokalni dev (Vite proxy na /backend): "backend".
API_PREFIX=backend

# --- Baza (PRIMARNA: PostgreSQL) ---
# NAPOMENA: Prisma driver adapter (@prisma/adapter-pg) i schema.prisma su fiksno
# vezani za PostgreSQL — provider se NE mijenja u runtime-u preko env varijable.
# DB_PROVIDER ispod je samo informativna oznaka za skripte/dokumentaciju/health-check,
# ne mijenja stvarno ponašanje Prisme.
DB_PROVIDER=postgresql
#
# DATABASE_HOST/DATABASE_URL se RAZLIKUJU dev vs produkcija (Postgres i backend su
# na istom fizičkom serveru, oba kao Docker kontejneri na dijeljenoj "web" mreži):
#
#   DEV (lokalna mašina, nije na "web" Docker mreži servera):
#     DATABASE_HOST=sql.ba101.top
#     DATABASE_URL=postgresql://evidens:PASSWORD@sql.ba101.top:5432/evidens
# PostgreSQL TLS is peer-verified. Set DATABASE_SSL_MODE=disable only for a
# trusted local/private development database that does not offer TLS.
# Supported modes: disable, require, verify-ca, verify-full. All enabled modes
# verify the peer certificate and hostname with minVersion TLSv1.2; provide a
# mounted CA file for a private CA, otherwise Node's system trust store is used.
# A `sslmode` inside DATABASE_URL must not disagree with DATABASE_SSL_MODE about
# whether TLS is on — the app fails closed instead of silently downgrading.
# Coolify docker-compose.yml defaults DATABASE_SSL_CA to its mounted CA file.
DATABASE_SSL_MODE=verify-full
# Example for a private CA: /run/secrets/postgres-ca.crt (read-only mount).
DATABASE_SSL_CA=
# Connection pool PO JEDNOJ backend replici (1-100). Budžet:
#   replike × DATABASE_POOL_MAX + document-worker + migracije + maintenance
# mora ostati ispod PostgreSQL max_connections (ostaviti rezervu za superuser).
# Periodični `postgres_pool_latency` log prati iskorištenost ovog poola.
DATABASE_POOL_MAX=10
#
#   PRODUKCIJA (docker-compose.prod.yml, backend kontejner je na "web" mreži
#   zajedno s Postgres kontejnerom → koristi Docker service/container ime
#   umjesto javne subdomene; nema izlaska na internet, brže i bez izlaganja
#   5432 porta javno). Ime kontejnera provjeri sa `docker network inspect web`.
#     DATABASE_HOST=<ime_postgres_kontejnera>
#     DATABASE_URL=postgresql://evidens:PASSWORD@<ime_postgres_kontejnera>:5432/evidens
#
DATABASE_HOST=sql.ba101.top
DATABASE_PORT=5432
DATABASE_USER=evidens
DATABASE_PASSWORD=
DATABASE_NAME=evidens
# Prisma / backend connection string (koristi se ako je postavljen; ima prioritet nad gornjim poljima)
DATABASE_URL=postgresql://evidens:PASSWORD@sql.ba101.top:5432/evidens

# --- Baza (BACKUP / rollback: MySQL — više NIJE aktivna) ---
# Ostavljeno namjerno radi mogućnosti povratka na staru bazu. Da bi se MySQL ponovo
# koristio, potrebno je vratiti backend/prisma/schema.mysql.prisma.bak → schema.prisma,
# vratiti @prisma/adapter-mariadb + mariadb pakete i create-prisma-client.ts na staru verziju
# (vidi migracija-mysql-postgres.md, sekcija "Rollback na MySQL").
# DATABASE_HOST_MYSQL_BACKUP=
# DATABASE_PORT_MYSQL_BACKUP=3306
# DATABASE_USER_MYSQL_BACKUP=
# DATABASE_PASSWORD_MYSQL_BACKUP=
# DATABASE_NAME_MYSQL_BACKUP=inventory-v3
# DATABASE_URL_MYSQL_BACKUP=mysql://USER:PASSWORD@HOST:3306/inventory-v3

# --- Setup (produkcija, opcionalno) ---
# Ako je postavljen, POST /backend/setup/initialize zahtijeva isti token u tijelu
SETUP_TOKEN=

# --- Auth ---
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Uploads ---
# Produkcija (docker-compose.prod.yml): host /mnt/shared-app-files/inventory-v2 → /app/uploads
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=10

# --- CORS ---
# Lokalni dev (Vite proxy): http://localhost:5173
# Produkcija (Coolify): obavezna allow-lista za HTTP i WebSocket (startup
# odbija praznu ili wildcard vrijednost); tačno frontend origin, bez trailing "/" ili putanje.
CORS_ORIGIN=https://evidens.ba101.top

# --- Frontend (Vite) ---
# npm run dev: uvijek koristi /backend + proxy (VITE_DEV_API_PROXY → backend)
VITE_DEV_API_PROXY=http://localhost:3000
# npm run build (produkcija): puni URL API-ja — backend je na svojoj subdomeni
# (api.evidens.ba101.top), BEZ /backend nastavka.
VITE_API_URL=https://api.evidens.ba101.top
VITE_APP_NAME=Evidens
# QR naljepnice (produkcijski origin); fallback u dev: window.location.origin
VITE_APP_URL=https://evidens.ba101.top

# --- Docker / runtime ---
BACKEND_PORT=3000
# NODE_ENV: ne stavljati u .env — Vite dev čita root .env i prijavljuje grešku.
# Docker: NODE_ENV=production u backend/Dockerfile i docker-compose*.yml

# --- Redis (centralna platforma — vidi redis-platform repo/isporuku) ---
# Produkcija (Coolify, docker-compose.yml): povezuje se preko "redis_net" na
# centralni "redis-core" servis, koristeći dediciranog ACL usera ograničenog
# na REDIS_KEY_PREFIX namespace (npr. "inventory-v2" → svi ključevi/pubsub
# kanali ove aplikacije su "inventory-v2:*", u skladu sa ACL ~inventory-v2:*
# pravilom — vidi acl/users.acl na centralnoj Redis platformi).
# Standalone (docker-compose.prod.yml): koristi paketovani "redis" servis iz
# tog fajla — nema ACL-a (samo requirepass), REDIS_USERNAME ostaje prazan.
REDIS_HOST=redis-core
REDIS_PORT=6379
REDIS_USERNAME=inventory-v2
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=inventory-v2
REDIS_TLS=false
# Set REDIS_TLS=true for TLS. For a private/self-signed Redis CA, provide a
# readable CA PEM file inside BOTH backend and document-worker containers.
# Example: REDIS_CA_CERT_PATH=/run/secrets/redis-ca.crt
# Mount/provision that file as a read-only secret in each service. Backend and
# document-worker always set rejectUnauthorized=true and minVersion=TLSv1.2;
# TLS peer and hostname verification remain enabled (do not use
# NODE_TLS_REJECT_UNAUTHORIZED=0). The certificate SAN must contain REDIS_HOST.
REDIS_CA_CERT_PATH=

# --- Rate limiting (Redis-backed) ---
# Login brute-force protection.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SEC=60
# true rejects login with 503 if Redis is unavailable; false preserves
# availability but temporarily bypasses brute-force protection (default).
RATE_LIMIT_LOGIN_FAIL_CLOSED=false
# Anonymous QR lookups use an independent per-IP bucket (defaults: 60/minute).
RATE_LIMIT_PUBLIC_EQUIPMENT_MAX=60
RATE_LIMIT_PUBLIC_EQUIPMENT_WINDOW_SEC=60
# Fail-open preserves QR lookup availability on Redis outage; set true to reject
# requests with 503 until the distributed limiter is available again.
RATE_LIMIT_PUBLIC_EQUIPMENT_FAIL_CLOSED=false

# --- Inventory scheduler ---
# Dnevni cron (draft/lock/close sesije) — uključiti SAMO u produkciji kad je
# organizacija spremna za automatizovane inventurne cikluse. Zaštićen Redis
# distribuiranim lock-om (vidi inventory-scheduler.service.ts) — bezbjedno
# i ako se backend ikad skalira na više instanci.
INVENTORY_SCHEDULER_ENABLED=false

# --- Document Engine (BullMQ `document-generation` red + zaseban
# document-worker/ servis sa LibreOffice-om — vidi backend/src/modules/documents/
# i document-worker/README ako postoji). Worker koristi ISTE REDIS_* varijable
# kao backend iznad (isti ACL user/namespace — nema potrebe za novim ACL-om).
# Sve što je ovdje NE čita backend nego SAMO document-worker kontejner.
#
# Naziv BullMQ reda — mora biti IDENTIČAN u backendu
# (DOCUMENT_GENERATION_QUEUE u document-generation.queue.ts) i workeru;
# mijenjajte samo ako ste svjesno preimenovali i jedno i drugo.
DOCUMENT_QUEUE_NAME=document-generation
# Koliko soffice konverzija worker kontejner radi ISTOVREMENO. Svaka dobija
# izolovan profil, pa je >1 bezbjedno, ali LibreOffice je memorijski
# zahtjevan — uskladite sa mem_limit document-worker servisa u
# docker-compose*.yml (default tamo: 1536m/1.5 cpu za concurrency=2).
DOCUMENT_WORKER_CONCURRENCY=2
# Tvrdi timeout (ms) po pojedinačnoj soffice konverziji — nakon isteka
# proces se prisilno ubija (SIGKILL) da zaglavljeni LibreOffice ne blokira
# worker slot unedogled.
DOCUMENT_WORKER_CONVERT_TIMEOUT_MS=120000
# Interni health-check HTTP port (127.0.0.1 SAMO, nikad javno izložen).
# Ako se promijeni, mora se ažurirati i HEALTHCHECK CMD u
# document-worker/Dockerfile (hardkodiran radi jednostavnosti build-a).
DOCUMENT_WORKER_HEALTH_PORT=8080

