# --- App ---
APP_NAME=inventory-v2
APP_DISPLAY_NAME=Inventory v2
APP_SUBTITLE=Hijerarhijska evidencija i zaduženje opreme
APP_URL=https://inventory-v2.ba101.top
API_PREFIX=backend

# --- External MySQL (postojeći server — popuni vrijednosti) ---
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=inventory_v2
# Prisma / backend connection string
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/inventory_v2

# --- Auth ---
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Uploads ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=10

# --- CORS ---
CORS_ORIGIN=https://inventory-v2.ba101.top

# --- Frontend build (Vite) ---
VITE_API_URL=https://inventory-v2.ba101.top/backend
VITE_APP_NAME=Inventory v2

# --- Docker / runtime ---
BACKEND_PORT=3000
NODE_ENV=production
